# Copy to .env and adjust. Never commit .env (NFR-02.2).

# Owner connection: used only by ETL / training / prediction jobs (CLI).
DATABASE_URL=postgresql+psycopg://polypicker:polypicker_dev@localhost:5433/polypicker

# Read-only connection: used by the public FastAPI app.
API_DATABASE_URL=postgresql+psycopg://polypicker_api:polypicker_api_dev@localhost:5433/polypicker

# Folder holding the raw source files (Games.csv, PlayerStatistics.csv, ...).
DATA_DIR=../data

# Where trained model artifacts are written.
ARTIFACTS_DIR=./artifacts

# First season to import (start year). 2023 = the 2023-24 season (FR-04.1).
FIRST_SEASON=2023

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Optional: the-odds-api.com key (Pinnacle + major US books for NBA games; free plan = 500 calls/month).
ODDS_API_KEY=

# Optional: where job-failure alerts go (run-all / refresh / scores). An ntfy.sh topic URL (free phone push with the
# ntfy app, e.g. https://ntfy.sh/polypicker-<something-random>), or a Discord / Slack incoming-webhook URL.
ALERT_WEBHOOK_URL=
# macOS desktop notification when a job fails (ignored on Linux servers).
ALERT_DESKTOP=true
