# Server-side base URL of the PolyPicker FastAPI backend (Server Components + the /api/v1 proxy)
API_URL=http://localhost:8000/api/v1
# Browser-side base URL. Default "/api/v1" goes through this site's own proxy (works on phones,
# in the installed PWA, and needs no CORS). Only set it if the API is served from another origin.
# NEXT_PUBLIC_API_URL=/api/v1
